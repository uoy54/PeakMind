<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PeakMind.Pages.Login" >
    <StackLayout Padding="20" Spacing="10" >
        <Entry x:Name="UsernameEntry" Placeholder="Username" TextColor="BurlyWood"/>
        <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" TextColor="BurlyWood" />
        <Button Text="Login" Clicked="LoginButton_Clicked"  BackgroundColor="MediumPurple" />
        <Button Text="Register" Clicked="RegisterButton_Clicked" BackgroundColor="MediumPurple" />
        
    </StackLayout>
</ContentPage>